{
  "devDependencies": {
    "@types/chart.js": "^2.9.41",
    "assemblyscript": "^0.28.10",
    "esbuild": "^0.27.4",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./build/release.js",
      "types": "./build/release.d.ts"
    }
  },
  "scripts": {
    "build:ts": "tsc",
    "bundle": "esbuild src/ui.ts --bundle --outfile=dist/bundle.js --minify --sourcemap --platform=browser --format=iife",
    "wasm:build": "cd rust_engine && wasm-pack build --target web",
    "wasm:inline": "node scripts/inline-wasm.js",
    "build": "npm run wasm:build && npm run wasm:inline && npm run bundle",
    "test": "node --test",
    "start": "npx serve ."
  }
}
