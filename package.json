{
  "name": "mc-enchanting-analyzer",
  "version": "1.0.0-rc",
  "devDependencies": {
    "@types/chart.js": "^2.9.41",
    "@types/node": "^25.5.0",
    "assemblyscript": "^0.28.10",
    "esbuild": "^0.27.4",
    "typescript": "^5.9.3",
    "tsx": "^4.19.2"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./build/release.js",
      "types": "./build/release.d.ts"
    }
  },
  "scripts": {
    "build:ts": "tsc",
    "build:js": "esbuild src/ui.ts src/worker.ts --bundle --outdir=dist --minify --sourcemap --platform=browser",
    "build:bundle": "node scripts/bundle-worker.js",
    "build": "npm run build:js && npm run build:bundle",
    "build:standalone": "npm run build && node scripts/inline-assets.js",
    "test": "tsx --test src/engine.test.ts",
    "start": "npx serve ."
  }
}
