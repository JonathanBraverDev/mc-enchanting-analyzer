{
  "name": "mc-enchanting-analyzer",
  "version": "3.2.0",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/chart.js": "^2.9.41",
    "@types/node": "^25.5.0",
    "assemblyscript": "^0.28.10",
    "esbuild": "^0.27.4",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "start": "npx serve .",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.mkdirSync('dist', { recursive: true });\"",
    "build": "npm run clean && npm run build:js && npm run build:bundle",
    "build:ts": "tsc",
    "build:js": "esbuild src/ui/index.ts --bundle --outfile=dist/ui.js --minify --sourcemap --platform=browser && esbuild src/worker/worker.ts --bundle --outfile=dist/worker.js --minify --sourcemap --platform=browser",
    "build:bundle": "node scripts/bundle-worker.js",
    "build:standalone": "npm run build && node scripts/inline-assets.js",
    "test": "npm run test:all",
    "test:all": "npm run build && npm run test:engine && npm run test:ui",
    "test:engine": "tsx --test tests/unit/**/*.test.ts tests/integration/**/*.test.ts tests/diagnostics/**/*.test.ts tests/infra/*.test.ts",
    "test:snapshots": "tsx --test --test-name-pattern=\"Snapshot:\" tests/unit/engine/engine.test.ts",
    "test:ui": "playwright test",
    "benchmark": "tsx tests/benchmarks/engine-perf.bench.ts",
    "update-snapshots": "tsx scripts/update-snapshots.ts",
    "release": "npm run test:all && npm run build:standalone"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#core/*": "./src/lib/core/*",
    "#data/*": "./src/lib/data/*",
    "#engine/*": "./src/lib/engine/*",
    "#services/*": "./src/lib/services/*",
    "#types/*": "./src/lib/types/*",
    "#utils/*": "./src/lib/utils/*",
    "#constants/*": "./src/lib/constants/*",
    "#ui/*": "./src/ui/*",
    "#worker/*": "./src/worker/*",
    "#tests/*": "./tests/*"
  }
}
