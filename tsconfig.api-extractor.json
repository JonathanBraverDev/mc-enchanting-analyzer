{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#lib/*": ["tmp/api-types/*"],
      "#core/*": ["tmp/api-types/core/*"],
      "#data/*": ["tmp/api-types/data/*"],
      "#engine/*": ["tmp/api-types/engine/*"],
      "#services/*": ["tmp/api-types/services/*"],
      "#types/*": ["tmp/api-types/types/*"],
      "#utils/*": ["tmp/api-types/utils/*"],
      "#constants/*": ["tmp/api-types/constants/*"],
      "#ui/*": ["tmp/api-types/../ui/*"],
      "#worker/*": ["tmp/api-types/../worker/*"],
      "#tests/*": ["tests/*"]
    }
  },
  "include": [
    "tmp/api-types/**/*"
  ]
}
